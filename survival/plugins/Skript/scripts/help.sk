# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – Survival

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (rotierend, alle 10 Minuten) ---
on script load:
    set {survival_bc_i} to 0

every 10 minutes:
    add 1 to {survival_bc_i}
    if {survival_bc_i} is greater than 4:
        set {survival_bc_i} to 1
    loop all players:
        if {survival_bc_i} is 1:
            send "&8[&a&lSurvival&8] &7Neu hier? Öffne mit &e/help &7oder &e/nav &7das Hilfe-Menü und sichere dir danach &e/daily&7." to loop-player
        else if {survival_bc_i} is 2:
            send "&8[&a&lSurvival&8] &7Verdiene Startkapital mit &e/jobs &7und &e/shop&7, dann geht es mit &e/rankup &7weiter." to loop-player
        else if {survival_bc_i} is 3:
            send "&8[&a&lSurvival&8] &7Nutze &e/warpmenu&7, sichere dir im Tycoon ein Plot mit &e/plot auto &7und baue dein Generatoren-Setup aus." to loop-player
        else:
            send "&8[&a&lSurvival&8] &7Prüfe mit &e/event &7aktive Boni, lies &e/tips &7für den nächsten Schritt und nutze &e/lobby &7zum Wechseln." to loop-player
