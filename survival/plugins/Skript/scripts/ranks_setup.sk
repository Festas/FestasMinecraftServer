# ============================================================================
# RANG-TAGS SETUP (LuckPerms Prefixes)
# ----------------------------------------------------------------------------
# Setzt fuer ALLE Raenge automatisch das korrekte Gewicht (weight) und den
# richtigen Tag (LuckPerms-Prefix) - aehnlich wie /sthc (tycoon_setup.sk),
# nur fuer die Haupt-Rangleiter (autorank-Track) sowie Donator- und Team-Raenge.
#
# Aufruf:  /setupranktags        (Permission: op)
#
# Hinweise:
# 1. LuckPerms ist netzwerkweit geteilt (shared s4_perms) -> einmal auf
#    Survival ausfuehren genuegt, gilt sofort auf allen Servern.
# 2. Idempotent: kann jederzeit gefahrlos erneut ausgefuehrt werden. Passt du
#    einen Tag hier an, einfach den Befehl erneut ausfuehren = fertig.
# 3. Tycoon-Raenge (tycoon_*) werden hier bewusst NICHT angefasst, die haben
#    ihr eigenes Setup ueber /sthc (tycoon_setup.sk, world=tycoon Kontext).
# 4. Farbcodes: "&#rrggbb" = Hex-Farbe, "&x"/"&l" = klassische Codes.
#    Prefix-Werte mit Leerzeichen stehen in doppelten Anfuehrungszeichen
#    (in Skript per "" escaped). Das Leerzeichen am Ende trennt Tag vom Namen.
# ============================================================================

command /setupranktags:
    permission: op
    trigger:
        send "&eStarte Rang-Tag Setup (LuckPerms)..." to console

        # --- Haupt-Rangleiter (autorank-Track: default -> maincharacter) ---
        execute console command "luckperms group default setweight 100"
        wait 5 ticks
        execute console command "luckperms group default meta setprefix 1 ""&#9e9e9e[&7NPC&#9e9e9e]&7 """
        wait 5 ticks
        send "&7- default &8(NPC)" to console

        execute console command "luckperms creategroup lauch"
        wait 15 ticks
        execute console command "luckperms group lauch setweight 200"
        wait 5 ticks
        execute console command "luckperms group lauch meta setprefix 200 ""&#bdffbd[&#e3ffe3🌱 Lauch&#bdffbd]&7 """
        wait 5 ticks
        send "&7- lauch &8(Lauch)" to console

        execute console command "luckperms creategroup knecht"
        wait 15 ticks
        execute console command "luckperms group knecht setweight 300"
        wait 5 ticks
        execute console command "luckperms group knecht meta setprefix 300 ""&#8a5a2a[&#b07b46⚒ Knecht&#8a5a2a]&7 """
        wait 5 ticks
        send "&7- knecht &8(Knecht)" to console

        execute console command "luckperms creategroup chiller"
        wait 15 ticks
        execute console command "luckperms group chiller setweight 400"
        wait 5 ticks
        execute console command "luckperms group chiller meta setprefix 400 ""&#85f2ff[&#bdfaff❄ Chiller&#85f2ff]&7 """
        wait 5 ticks
