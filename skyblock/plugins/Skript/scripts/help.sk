# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – Skyblock

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (alle 10 Minuten) ---
every 10 minutes:
    broadcast "&8[&b&lSkyblock&8] &7Neu auf der Insel? Tippe &e/help &7für Infos zu Inseln, Freunde-Koop und mehr!"
