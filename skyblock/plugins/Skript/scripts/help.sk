# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – Skyblock

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (rotierend, alle 10 Minuten) ---
on script load:
    set {skyblock_bc_i} to 0

every 10 minutes:
    add 1 to {skyblock_bc_i}
    if {skyblock_bc_i} is greater than 4:
        set {skyblock_bc_i} to 1
    loop all players:
        if {skyblock_bc_i} is 1:
            send "&8[&3&lSkyblock&8] &7Neu hier? Öffne mit &e/help &7oder &e/nav &7das Hilfe-Menü und starte mit &e/is create&7." to loop-player
        else if {skyblock_bc_i} is 2:
            send "&8[&3&lSkyblock&8] &7Hol dir mit &e/daily &7deine Belohnung, lies &e/tips &7und plane dein Team mit &e/is invite <Spieler>&7." to loop-player
        else if {skyblock_bc_i} is 3:
            send "&8[&3&lSkyblock&8] &7Schließe &e/is missions &7ab und handle deine Ressourcen clever im &e/bazaar&7." to loop-player
        else:
            send "&8[&3&lSkyblock&8] &7Besuche andere Inseln mit &e/is warps &7oder direkt per &e/is visit <Spieler>&7." to loop-player
