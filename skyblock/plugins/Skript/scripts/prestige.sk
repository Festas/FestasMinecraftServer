# ============================================================
#  Prestige-System — RPG & Skyblock
#  Befehle: /prestige, /prestige top, /prestige info
# ============================================================

options:
    prefix: &e&l⭐ Prestige &8» &r
    max_prestige: 10
    required_level: 100
    stat_bonus_per_prestige: 5

# ============================================================
#  Hilfsfunktionen
# ============================================================

function prestigeStars(level: number) :: text:
    if {_level} <= 0:
        return "&7Kein Prestige"
    set {_stars} to ""
    loop {_level} times:
        set {_stars} to "%{_stars}%✦"
    if {_level} is 1:
        return "&e%{_stars}%"
    else if {_level} is 2:
        return "&e%{_stars}%"
    else if {_level} is 3:
        return "&6%{_stars}%"
    else if {_level} is 4:
        return "&6%{_stars}%"
    else if {_level} is 5:
        return "&c%{_stars}%"
    else if {_level} is 6:
        return "&c%{_stars}%"
    else if {_level} is 7:
        return "&5%{_stars}%"
    else if {_level} is 8:
        return "&5%{_stars}%"
    else if {_level} is 9:
        return "&d%{_stars}%"
    else if {_level} >= 10:
        return "&4&l%{_stars}%"
    return "&7%{_stars}%"

function prestigeTitle(level: number) :: text:
    if {_level} is 0:
        return "&7Anfänger"
    else if {_level} is 1:
        return "&eNovize"
    else if {_level} is 2:
        return "&eLehrling"
    else if {_level} is 3:
        return "&6Geselle"
    else if {_level} is 4:
        return "&6Experte"
    else if {_level} is 5:
        return "&cMeister"
    else if {_level} is 6:
        return "&cGroßmeister"
    else if {_level} is 7:
        return "&5Champion"
    else if {_level} is 8:
        return "&5Legende"
    else if {_level} is 9:
        return "&dMythisch"
    else if {_level} >= 10:
        return "&4&lUnsterblich"
    return "&7Unbekannt"

function prestigeStatBonus(level: number) :: number:
    return {_level} * {@stat_bonus_per_prestige}

function applyPrestigeEffects(p: player):
    set {_prestige} to {prestige.%{_p}%.level} ? 0
    if {_prestige} <= 0:
        return
    set {_bonus} to prestigeStatBonus({_prestige})
    # Apply passive effects based on prestige
    if {_prestige} >= 2:
        apply speed 1 without particles to {_p} for 999 days
    if {_prestige} >= 4:
        apply haste 1 without particles to {_p} for 999 days
    if {_prestige} >= 6:
        apply resistance 1 without particles to {_p} for 999 days
    if {_prestige} >= 8:
        apply strength 1 without particles to {_p} for 999 days
    if {_prestige} >= 10:
        apply regeneration 1 without particles to {_p} for 999 days

function openPrestigeConfirmation(p: player):
    set {_gui} to chest inventory with 3 rows named "&e&l⭐ Prestige bestätigen?"
    set {_prestige} to {prestige.%{_p}%.level} ? 0
    set {_next} to {_prestige} + 1
    set {_stars} to prestigeStars({_next})
    set {_title} to prestigeTitle({_next})
    set {_bonus} to prestigeStatBonus({_next})

    # Info
    set slot 4 of {_gui} to nether star named "&e&lPrestige %{_next}%" with lore "&7Aktuell: %prestigeStars({_prestige})%", "&7Nächstes: %{_stars}%", "", "&7Titel: %{_title}%", "&7Stat-Bonus: &a+%{_bonus}%%%", "", "&c⚠ Dein Level wird auf 1 zurückgesetzt!", "&a✔ Items und Währung bleiben erhalten." and ""

    # Confirm
    set slot 11 of {_gui} to lime stained glass pane named "&a&l✔ Bestätigen" with lore "&7Klicke um Prestige %{_next}% zu erreichen!"

    # Cancel
    set slot 15 of {_gui} to red stained glass pane named "&c&l✖ Abbrechen" with lore "&7Zurück zum Spiel."

    open {_gui} to {_p}

# ============================================================
#  Befehle
# ============================================================

command /prestige [<text = "info">]:
    trigger:
        set {_prestige} to {prestige.%player%.level} ? 0

        if arg-1 is "info":
            set {_stars} to prestigeStars({_prestige})
            set {_title} to prestigeTitle({_prestige})
            set {_bonus} to prestigeStatBonus({_prestige})
            send ""
            send "{@prefix}&eDein Prestige-Status:"
            send "  &7Prestige: %{_stars}% &7(%{_prestige}%/{@max_prestige})"
            send "  &7Titel: %{_title}%"
            send "  &7Stat-Bonus: &a+%{_bonus}%%%"
            if {_prestige} < {@max_prestige}:
                send "  &7Nächstes Prestige: &eLevel {@required_level} benötigt"
            else:
                send "  &6&l✦ Maximales Prestige erreicht!"
            send ""
            send "  &6/prestige &8- &7Prestige durchführen"
            send "  &6/prestige top &8- &7Bestenliste"
            send ""

        else if arg-1 is "up" or "aufsteigen":
            if {_prestige} >= {@max_prestige}:
                send "{@prefix}&cDu hast bereits das maximale Prestige erreicht!"
                stop
            if level of player < {@required_level}:
                send "{@prefix}&cDu benötigst Level &e{@required_level}&c, um Prestige aufzusteigen!"
                send "{@prefix}&7Dein Level: &e%level of player%&7/{@required_level}"
                stop
            openPrestigeConfirmation(player)

        else if arg-1 is "top" or "bestenliste":
            send ""
            send "{@prefix}&6&lPrestige-Bestenliste:"
            send ""
            set {_count} to 0
            # Sort players by prestige level
            loop {prestige.leaderboard::*}:
                add 1 to {_count}
                if {_count} > 10:
                    stop
                set {_uuid} to loop-value
                set {_pLevel} to {prestige.%{_uuid}%.level} ? 0
                set {_pName} to {prestige.%{_uuid}%.name} ? "Unbekannt"
                set {_pStars} to prestigeStars({_pLevel})
                if {_count} is 1:
                    send "  &6&l#1 &e%{_pName}% &8- %{_pStars}%"
                else if {_count} is 2:
                    send "  &7&l#2 &e%{_pName}% &8- %{_pStars}%"
                else if {_count} is 3:
                    send "  &c&l#3 &e%{_pName}% &8- %{_pStars}%"
                else:
                    send "  &7#%{_count}% &e%{_pName}% &8- %{_pStars}%"
            if {_count} is 0:
                send "  &7Noch keine Einträge!"
            send ""

        else:
            send "{@prefix}&eBefehle:"
            send "  &6/prestige info &8- &7Zeigt deinen Status"
            send "  &6/prestige up &8- &7Prestige durchführen"
            send "  &6/prestige top &8- &7Bestenliste"

# ============================================================
#  GUI-Handler
# ============================================================

on inventory click:
    if name of event-inventory is "&e&l⭐ Prestige bestätigen?":
        cancel event
        if name of event-slot contains "&a&l✔ Bestätigen":
            close player's inventory
            # Perform prestige
            set {_prestige} to {prestige.%player%.level} ? 0
            if {_prestige} >= {@max_prestige}:
                send "{@prefix}&cDu hast bereits das maximale Prestige!"
                stop
            if level of player < {@required_level}:
                send "{@prefix}&cDu hast nicht mehr das benötigte Level!"
                stop
            add 1 to {prestige.%player%.level}
            set {_newPrestige} to {prestige.%player%.level}
            set {_stars} to prestigeStars({_newPrestige})
            set {_title} to prestigeTitle({_newPrestige})
            set {_bonus} to prestigeStatBonus({_newPrestige})

            # Reset level
            set level of player to 0
            set player's exp to 0

            # Update leaderboard
            set {prestige.%player%.name} to name of player
            if {prestige.leaderboard::*} does not contain "%player%":
                add "%player%" to {prestige.leaderboard::*}

            # Announcement
            send "{@prefix}&a&l✦ PRESTIGE AUFGESTIEGEN! ✦" to player
            send "" to player
            send "{@prefix}&eDu bist jetzt %{_stars}% &e(Prestige %{_newPrestige}%)!" to player
            send "{@prefix}&eTitel: %{_title}%" to player
            send "{@prefix}&eNeuer Stat-Bonus: &a+%{_bonus}%%%" to player
            send "" to player

            # Server announcement
            broadcast "{@prefix}&6%player% &ehat &lPrestige %{_newPrestige}% %{_stars}% &eerreicht!"

            # Effects
            play sound "ui.toast.challenge_complete" with volume 1 and pitch 1 to player
            play sound "entity.ender_dragon.growl" with volume 0.5 and pitch 1.5 to player
            applyPrestigeEffects(player)

            # Particles
            execute console command "execute at %player% run particle totem_of_undying ~ ~1 ~ 1 1 1 50"

        else if name of event-slot contains "&c&l✖ Abbrechen":
            close player's inventory
            send "{@prefix}&7Prestige abgebrochen."

# ============================================================
#  Chat-Format mit Prestige-Sternen
# ============================================================

on chat:
    set {_prestige} to {prestige.%player%.level} ? 0
    if {_prestige} > 0:
        set {_stars} to prestigeStars({_prestige})
        set chat format to "%{_stars}% &7%player% &8» &f%message%"

# ============================================================
#  Join-Events
# ============================================================

on join:
    wait 1 second
    applyPrestigeEffects(player)
    set {_prestige} to {prestige.%player%.level} ? 0
    if {_prestige} > 0:
        set {_stars} to prestigeStars({_prestige})
        set {_title} to prestigeTitle({_prestige})
        send "{@prefix}&eWillkommen zurück, %{_title}% %{_stars}%&e!" to player

# ============================================================
#  Admin-Befehl
# ============================================================

command /prestigeadmin <text> [<player>] [<number>]:
    permission: prestige.admin
    permission message: {@prefix}&cKeine Berechtigung!
    trigger:
        if arg-1 is "set" or "setzen":
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /prestigeadmin set <Spieler> <Level>"
                stop
            if arg-3 is not set:
                send "{@prefix}&cNutzung: /prestigeadmin set <Spieler> <Level>"
                stop
            set {_level} to arg-3
            if {_level} < 0:
                set {_level} to 0
            if {_level} > {@max_prestige}:
                set {_level} to {@max_prestige}
            set {prestige.%arg-2%.level} to {_level}
            set {prestige.%arg-2%.name} to name of arg-2
            send "{@prefix}&aPrestige von %arg-2% auf &e%{_level}% &agesetzt."
            if arg-2 is online:
                applyPrestigeEffects(arg-2)
                send "{@prefix}&eDein Prestige wurde auf &6%{_level}% &egesetzt." to arg-2

        else if arg-1 is "reset":
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /prestigeadmin reset <Spieler>"
                stop
            delete {prestige.%arg-2%.level}
            delete {prestige.%arg-2%.name}
            send "{@prefix}&aPrestige von %arg-2% zurückgesetzt."

        else:
            send "{@prefix}&eAdmin-Befehle:"
            send "  &6/prestigeadmin set <Spieler> <Level>"
            send "  &6/prestigeadmin reset <Spieler>"
