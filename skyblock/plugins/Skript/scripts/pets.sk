# ============================================================
#  Haustier-System (Pet System) — Skyblock & RPG
#  Befehle: /pet, /pet list, /pet summon, /pet dismiss
# ============================================================

options:
    prefix: &6&l🐾 Pets &8» &r
    max_pet_level: 100
    xp_per_kill: 10
    xp_level_base: 50
    xp_level_multiplier: 1.15

# ============================================================
#  Hilfsfunktionen
# ============================================================

function petXpRequired(level: number) :: number:
    return ceil({_level} * {@xp_level_base} * {@xp_level_multiplier})

function petBonusMultiplier(level: number) :: number:
    return 1 + ({_level} / {@max_pet_level})

function applyPetEffects(p: player):
    set {_type} to {pet.%{_p}%.active}
    if {_type} is not set:
        return
    set {_level} to {pet.%{_p}%.%{_type}%.level} ? 1
    set {_mult} to petBonusMultiplier({_level})

    # Remove old effects first
    remove potion effect of strength from {_p}
    remove potion effect of luck from {_p}
    remove potion effect of haste from {_p}
    remove potion effect of speed from {_p}
    remove potion effect of resistance from {_p}

    if {_type} is "wolf":
        apply strength 1 without particles to {_p} for 999 days
    else if {_type} is "katze":
        apply luck 1 without particles to {_p} for 999 days
    else if {_type} is "biene":
        apply haste 1 without particles to {_p} for 999 days
    else if {_type} is "papagei":
        apply speed 1 without particles to {_p} for 999 days
    else if {_type} is "schildkroete":
        apply resistance 1 without particles to {_p} for 999 days
    else if {_type} is "drache":
        apply strength 1 without particles to {_p} for 999 days
        apply speed 1 without particles to {_p} for 999 days
        apply resistance 1 without particles to {_p} for 999 days

function removePetEffects(p: player):
    remove potion effect of strength from {_p}
    remove potion effect of luck from {_p}
    remove potion effect of haste from {_p}
    remove potion effect of speed from {_p}
    remove potion effect of resistance from {_p}

function petDisplayName(type: text) :: text:
    if {_type} is "wolf":
        return "&c🐺 Wolf"
    else if {_type} is "katze":
        return "&e🐱 Katze"
    else if {_type} is "biene":
        return "&6🐝 Biene"
    else if {_type} is "papagei":
        return "&a🦜 Papagei"
    else if {_type} is "schildkroete":
        return "&2🐢 Schildkröte"
    else if {_type} is "drache":
        return "&5🐉 Drache"
    return "&7Unbekannt"

function petDescription(type: text) :: text:
    if {_type} is "wolf":
        return "&7Kampf &8- &c+5%% Schaden"
    else if {_type} is "katze":
        return "&7Glück &8- &e+3%% Glück"
    else if {_type} is "biene":
        return "&7Farming &8- &6+10%% Ernte"
    else if {_type} is "papagei":
        return "&7Geschwindigkeit &8- &a+5%% Speed"
    else if {_type} is "schildkroete":
        return "&7Verteidigung &8- &2+8%% Rüstung"
    else if {_type} is "drache":
        return "&7Allrounder &8- &5+3%% alle Stats"
    return "&7Keine Beschreibung"

function petMobType(type: text) :: text:
    if {_type} is "wolf":
        return "wolf"
    else if {_type} is "katze":
        return "cat"
    else if {_type} is "biene":
        return "bee"
    else if {_type} is "papagei":
        return "parrot"
    else if {_type} is "schildkroete":
        return "turtle"
    else if {_type} is "drache":
        return "armor stand"
    return "armor stand"

function givePetXp(p: player, amount: number):
    set {_type} to {pet.%{_p}%.active}
    if {_type} is not set:
        return
    set {_level} to {pet.%{_p}%.%{_type}%.level} ? 1
    if {_level} >= {@max_pet_level}:
        return
    add {_amount} to {pet.%{_p}%.%{_type}%.xp}
    set {_required} to petXpRequired({_level})
    while {pet.%{_p}%.%{_type}%.xp} >= {_required}:
        if {_level} >= {@max_pet_level}:
            set {pet.%{_p}%.%{_type}%.xp} to 0
            stop
        subtract {_required} from {pet.%{_p}%.%{_type}%.xp}
        add 1 to {pet.%{_p}%.%{_type}%.level}
        add 1 to {_level}
        set {_name} to petDisplayName({_type})
        send "{@prefix}&aDein Pet %{_name}% &aist jetzt &e&lLevel %{_level}%&a!" to {_p}
        play sound "entity.player.levelup" with volume 1 and pitch 1.5 to {_p}
        set {_required} to petXpRequired({_level})
    applyPetEffects({_p})

# ============================================================
#  Pet-Entität verwalten
# ============================================================

function spawnPetEntity(p: player):
    set {_type} to {pet.%{_p}%.active}
    if {_type} is not set:
        return
    despawnPetEntity({_p})
    set {_loc} to location of {_p}
    set {_mobType} to petMobType({_type})
    set {_level} to {pet.%{_p}%.%{_type}%.level} ? 1
    set {_displayName} to petDisplayName({_type})
    if {_type} is "drache":
        spawn an armor stand at {_loc}
        set {_entity} to last spawned entity
        set name of {_entity} to "%{_displayName}% &7[Lv.%{_level}%]"
        set name visible of {_entity} to true
        set {_entity}'s helmet to dragon head
        add {_entity} to {pet.%{_p}%.entities::*}
    else:
        if {_mobType} is "wolf":
            spawn a wolf at {_loc}
        else if {_mobType} is "cat":
            spawn a cat at {_loc}
        else if {_mobType} is "bee":
            spawn a bee at {_loc}
        else if {_mobType} is "parrot":
            spawn a parrot at {_loc}
        else if {_mobType} is "turtle":
            spawn a turtle at {_loc}
        set {_entity} to last spawned entity
        set name of {_entity} to "%{_displayName}% &7[Lv.%{_level}%]"
        set name visible of {_entity} to true
        set ai of {_entity} to false
        set {_entity} to be invulnerable
        add {_entity} to {pet.%{_p}%.entities::*}
    set {pet.%{_p}%.entity} to {_entity}

function despawnPetEntity(p: player):
    loop {pet.%{_p}%.entities::*}:
        kill loop-value
    clear {pet.%{_p}%.entities::*}
    delete {pet.%{_p}%.entity}

# ============================================================
#  Pet-Folge-Mechanismus (alle 10 Ticks)
# ============================================================

every 10 ticks:
    loop all players:
        set {_entity} to {pet.%loop-player%.entity}
        if {_entity} is set:
            if {_entity} is alive:
                set {_pLoc} to location of loop-player
                set {_eLoc} to location of {_entity}
                if distance between {_pLoc} and {_eLoc} > 15:
                    teleport {_entity} to {_pLoc}
                else if distance between {_pLoc} and {_eLoc} > 3:
                    set {_dir} to vector from {_eLoc} to {_pLoc}
                    set vector length of {_dir} to 0.3
                    set {_newLoc} to location of {_entity}
                    set x of {_newLoc} to (x of {_newLoc}) + (x of {_dir})
                    set y of {_newLoc} to (y of {_newLoc}) + (y of {_dir})
                    set z of {_newLoc} to (z of {_newLoc}) + (z of {_dir})
                    teleport {_entity} to {_newLoc}
            else:
                spawnPetEntity(loop-player)

# ============================================================
#  GUI-Menü
# ============================================================

function openPetMenu(p: player):
    set {_gui} to chest inventory with 4 rows named "&6&l🐾 Deine Haustiere"

    set {_types::*} to "wolf", "katze", "biene", "papagei", "schildkroete" and "drache"
    set {_icons::*} to bone, cod, honeycomb, feather, scute and dragon head
    set {_slots::*} to 10, 11, 12, 13, 14 and 15

    set {_active} to {pet.%{_p}%.active}

    loop {_types::*}:
        set {_type} to loop-value
        set {_idx} to loop-index parsed as integer
        set {_slot} to {_slots::%{_idx}%}
        set {_icon} to {_icons::%{_idx}%}
        set {_name} to petDisplayName({_type})
        set {_desc} to petDescription({_type})
        set {_level} to {pet.%{_p}%.%{_type}%.level} ? 0
        set {_xp} to {pet.%{_p}%.%{_type}%.xp} ? 0
        set {_owned} to {pet.%{_p}%.%{_type}%.owned} ? false

        if {_owned} is true:
            if {_type} is {_active}:
                set slot {_slot} of {_gui} to {_icon} named "%{_name}% &a(Aktiv)" with lore "&7Level: &e%{_level}%", "&7XP: &b%{_xp}%&7/&b%petXpRequired({_level})%", "", {_desc}, "", "&c▶ Klicke zum Zurückrufen" and "&8ID: %{_type}%"
            else:
                set slot {_slot} of {_gui} to {_icon} named {_name} with lore "&7Level: &e%{_level}%", "&7XP: &b%{_xp}%&7/&b%petXpRequired({_level})%", "", {_desc}, "", "&a▶ Klicke zum Beschwören" and "&8ID: %{_type}%"
        else:
            set slot {_slot} of {_gui} to barrier named "&c✖ %{_name}% &c(Gesperrt)" with lore "&7Du besitzt dieses Pet noch nicht.", "", "&eErhalte es durch Events, Quests", "&eoder den Shop!" and "&8ID: %{_type}%"

    # Info item
    set slot 31 of {_gui} to book named "&e&lPet-Info" with lore "&7Pets geben dir passive Boni.", "&7Töte Mobs, um Pet-XP zu bekommen!", "" and "&7Max Level: &6{@max_pet_level}"

    open {_gui} to {_p}

# ============================================================
#  Befehle
# ============================================================

command /pet [<text = "menu">] [<text>]:
    trigger:
        if arg-1 is "menu" or "gui":
            openPetMenu(player)

        else if arg-1 is "list":
            send "{@prefix}&eVerfügbare Pet-Typen:"
            send " &c🐺 Wolf &8- &7Kampf +5%% Schaden"
            send " &e🐱 Katze &8- &7Glück +3%%"
            send " &6🐝 Biene &8- &7Farming +10%%"
            send " &a🦜 Papagei &8- &7Speed +5%%"
            send " &2🐢 Schildkröte &8- &7Rüstung +8%%"
            send " &5🐉 Drache &8- &7Alle Stats +3%%"

        else if arg-1 is "summon" or "beschwören":
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /pet summon <Typ>"
                send "{@prefix}&7Typen: wolf, katze, biene, papagei, schildkroete, drache"
                stop
            set {_type} to arg-2 in lower case
            set {_valid::*} to "wolf", "katze", "biene", "papagei", "schildkroete" and "drache"
            if {_valid::*} does not contain {_type}:
                send "{@prefix}&cUnbekannter Pet-Typ! Nutze /pet list"
                stop
            if {pet.%player%.%{_type}%.owned} is not true:
                send "{@prefix}&cDu besitzt dieses Pet noch nicht!"
                stop
            if {pet.%player%.active} is {_type}:
                send "{@prefix}&cDieses Pet ist bereits aktiv!"
                stop
            set {pet.%player%.active} to {_type}
            set {_name} to petDisplayName({_type})
            send "{@prefix}&aDu hast %{_name}% &abeschworen!"
            play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 to player
            spawnPetEntity(player)
            applyPetEffects(player)

        else if arg-1 is "dismiss" or "zurückrufen":
            if {pet.%player%.active} is not set:
                send "{@prefix}&cDu hast kein aktives Pet!"
                stop
            set {_name} to petDisplayName({pet.%player%.active})
            send "{@prefix}&eDu hast %{_name}% &ezurückgerufen."
            despawnPetEntity(player)
            removePetEffects(player)
            delete {pet.%player%.active}

        else if arg-1 is "give" or "geben":
            if player does not have permission "pet.admin":
                send "{@prefix}&cKeine Berechtigung!"
                stop
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /pet give <Spieler> <Typ>"
                stop
            # Admin give handled via /petadmin
            send "{@prefix}&cNutze &e/petadmin give <Spieler> <Typ>"

        else:
            send "{@prefix}&ePet-Befehle:"
            send " &6/pet &8- &7Öffnet das Pet-Menü"
            send " &6/pet list &8- &7Zeigt alle Pet-Typen"
            send " &6/pet summon <Typ> &8- &7Beschwört ein Pet"
            send " &6/pet dismiss &8- &7Ruft das Pet zurück"

command /petadmin <text> [<player>] [<text>]:
    permission: pet.admin
    permission message: {@prefix}&cKeine Berechtigung!
    trigger:
        if arg-1 is "give" or "geben":
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /petadmin give <Spieler> <Typ>"
                stop
            if arg-3 is not set:
                send "{@prefix}&cNutzung: /petadmin give <Spieler> <Typ>"
                stop
            set {_type} to arg-3 in lower case
            set {_valid::*} to "wolf", "katze", "biene", "papagei", "schildkroete" and "drache"
            if {_valid::*} does not contain {_type}:
                send "{@prefix}&cUnbekannter Pet-Typ!"
                stop
            set {pet.%arg-2%.%{_type}%.owned} to true
            set {pet.%arg-2%.%{_type}%.level} to 1
            set {pet.%arg-2%.%{_type}%.xp} to 0
            set {_name} to petDisplayName({_type})
            send "{@prefix}&aDu hast %arg-2% das Pet %{_name}% &agegeben!" to player
            send "{@prefix}&aDu hast ein neues Pet erhalten: %{_name}%&a!" to arg-2
            play sound "entity.player.levelup" with volume 1 and pitch 1 to arg-2

        else if arg-1 is "setlevel":
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /petadmin setlevel <Spieler> <Level>"
                stop
            if arg-3 is not set:
                send "{@prefix}&cNutzung: /petadmin setlevel <Spieler> <Level>"
                stop
            set {_type} to {pet.%arg-2%.active}
            if {_type} is not set:
                send "{@prefix}&cDer Spieler hat kein aktives Pet!"
                stop
            set {_level} to arg-3 parsed as integer
            if {_level} is not set:
                send "{@prefix}&cUngültiges Level!"
                stop
            if {_level} < 1:
                set {_level} to 1
            if {_level} > {@max_pet_level}:
                set {_level} to {@max_pet_level}
            set {pet.%arg-2%.%{_type}%.level} to {_level}
            set {pet.%arg-2%.%{_type}%.xp} to 0
            send "{@prefix}&aPet-Level von %arg-2% auf &e%{_level}% &agesetzt."

        else:
            send "{@prefix}&eAdmin-Befehle:"
            send " &6/petadmin give <Spieler> <Typ> &8- &7Pet geben"
            send " &6/petadmin setlevel <Spieler> <Level> &8- &7Level setzen"

# ============================================================
#  GUI-Klick-Handler
# ============================================================

on inventory click:
    if name of event-inventory is "&6&l🐾 Deine Haustiere":
        cancel event
        set {_item} to event-slot
        if {_item} is air:
            stop
        if {_item} is barrier:
            send "{@prefix}&cDieses Pet ist noch gesperrt!"
            play sound "entity.villager.no" with volume 1 and pitch 1 to player
            stop
        set {_lore} to lore of {_item}
        # Extract pet type from last lore line (ID line)
        set {_lines::*} to {_lore} split by "%nl%"
        loop {_lines::*}:
            if loop-value contains "&8ID: ":
                set {_type} to loop-value
                replace "&8ID: " in {_type} with ""
                replace all " " in {_type} with ""

        if {_type} is not set:
            stop

        if {pet.%player%.active} is {_type}:
            # Dismiss
            close player's inventory
            make player execute command "/pet dismiss"
        else:
            # Summon
            close player's inventory
            make player execute command "/pet summon %{_type}%"

# ============================================================
#  XP durch Mob-Kills
# ============================================================

on death of a monster:
    set {_killer} to attacker
    if {_killer} is a player:
        if {pet.%{_killer}%.active} is set:
            set {_xp} to {@xp_per_kill}
            # Bonus XP for harder mobs
            if victim is a wither skeleton:
                set {_xp} to 25
            else if victim is an enderman:
                set {_xp} to 20
            else if victim is a blaze:
                set {_xp} to 20
            else if victim is a wither:
                set {_xp} to 500
            else if victim is an ender dragon:
                set {_xp} to 1000
            givePetXp({_killer}, {_xp})

# ============================================================
#  Spieler-Join: Pet wiederherstellen
# ============================================================

on join:
    wait 2 seconds
    if {pet.%player%.active} is set:
        set {_name} to petDisplayName({pet.%player%.active})
        send "{@prefix}&aDein Pet %{_name}% &awurde wiederhergestellt!"
        spawnPetEntity(player)
        applyPetEffects(player)

# ============================================================
#  Spieler-Quit: Pet-Entität entfernen
# ============================================================

on quit:
    despawnPetEntity(player)
    removePetEffects(player)

# ============================================================
#  Spieler-Tod: Pet-Entität entfernen & respawn
# ============================================================

on death of player:
    despawnPetEntity(victim)

on respawn:
    wait 1 second
    if {pet.%player%.active} is set:
        spawnPetEntity(player)
        applyPetEffects(player)

# ============================================================
#  Welt-Wechsel: Pet mitnehmen
# ============================================================

on world change:
    despawnPetEntity(player)
    wait 5 ticks
    if {pet.%player%.active} is set:
        spawnPetEntity(player)
