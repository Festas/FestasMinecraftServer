# Pfad: plugins/Skript/scripts/navigator.sk
# Skyblock Navigator: /lobby, Netzwerk-Kompass (feste Navigation) + Server-Tipps
# WICHTIG: Bei den Optionen KEINE Anführungszeichen nutzen!

options:
    lobby_server: lobby

# --- LOBBY BEFEHL (wie Survival/Mining) ---
command /lobby:
    description: Teleportiert dich zur Lobby
    aliases: /l, /hub, /lob
    trigger:
        message "&7Du wirst zur &bLobby &7gesendet..."
        connect player to server "{@lobby_server}"

# --- NAVIGATIONS- / HILFE-MENÜ ---
command /nav:
    description: Öffnet das Navigations- & Hilfe-Menü
    aliases: /navigator
    trigger:
        make player execute command "/dm open help_menu"

# --- SERVER-TIPPS ---
command /tips:
    description: Zeigt einen zufälligen Skyblock-Tipp
    aliases: /tipp, /tip
    trigger:
        skyblockTip(player)

function skyblockTip(p: player):
    delete {_tips::*}
    add "&7Starte mit &e/is create &7und lade Freunde per &e/is invite <Spieler> &7auf deine Insel ein!" to {_tips::*}
    add "&7Platziere wertvolle Blöcke, um dein &bInsel-Level &7zu steigern: &e/is level" to {_tips::*}
    add "&7Handel clever im &e/bazaar &7– kaufe günstig und verkaufe teuer!" to {_tips::*}
    add "&7Setze deinen Insel-Spawn mit &e/is sethome&7, damit du schnell zurückfindest." to {_tips::*}
    add "&7Erweitere deine Insel-Grenze über das &e/is &7Menü mit Upgrades." to {_tips::*}
    add "&7Schließe &e/is missions &7ab und kassiere fette Belohnungen!" to {_tips::*}
    add "&7Besuche andere Inseln mit &e/is warps &7und setze eigene Warps für Besucher." to {_tips::*}
    add "&7Vergleiche dich mit anderen in der &e/is top &7Rangliste." to {_tips::*}
    add "&7Der &bNetzwerk-Kompass &7in deinem Inventar öffnet jederzeit das Hilfe-Menü." to {_tips::*}
    set {_tip} to random element out of {_tips::*}
    send "&8[&3&lSkyblock&8] &7Tipp: %{_tip}%" to {_p}

# --- NETZWERK-KOMPASS GEBEN (nicht-destruktiv) ---
on join:
    wait 15 ticks
    ensureCompass(player)
    wait 3 seconds
    skyblockTip(player)

on respawn:
    wait 10 ticks
    ensureCompass(player)

function ensureCompass(p: player):
    # Prüfen, ob der Spieler bereits einen Netzwerk-Kompass besitzt
    set {_has} to false
    loop 36 times:
        set {_idx} to loop-number - 1
        set {_it} to slot {_idx} of {_p}'s inventory
        if {_it} is compass:
            if name of {_it} contains "Netzwerk-Kompass":
                set {_has} to true
    if {_has} is false:
        set {_kompass} to compass named "&b&l🧭 Netzwerk-Kompass &7(Rechtsklick)" with lore "&7Öffnet Navigation, Warps & Tipps" and "&7Rechtsklick zum Öffnen"
        if slot 8 of {_p}'s inventory is air:
            set slot 8 of {_p}'s inventory to {_kompass}
        else:
            give {_kompass} to {_p}

# --- INTERAKTION MIT DEM KOMPASS ---
on right click:
    if player's tool is compass:
        if name of player's tool contains "Netzwerk-Kompass":
            cancel event
            make player execute command "/dm open help_menu"

on drop:
    if name of event-item contains "Netzwerk-Kompass":
        cancel event
        send "&8[&3&lSkyblock&8] &7Deinen &bNetzwerk-Kompass &7kannst du nicht wegwerfen." to player
