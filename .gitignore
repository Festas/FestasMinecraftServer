# Temporary files
*.tmp
*.bak
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.iml

# Build artifacts
target/
build/
dist/

# Logs
*.log
logs/

# Test files
test-server/

# ========================
# Minecraft Server Runtime
# ========================

# Runtime data & caches (not configs, not editable)
**/bStats/
**/cache/
**/lastupdate
**/*.lock
**/Saves/
**/internal/
**/.hopper/

# ProtocolLib runtime
**/ProtocolLib/lastupdate
**/ProtocolLib/error/

# Database files (binary, not editable)
**/punishments-database.*
*.db
*.mv.db
*.sqlite
**/*.db
**/*.mv.db

# Database backups
**/DatabaseBackups/

# Skript backups
**/Skript/backups/

# Resource pack archives (binary)
**/Oraxen/pack/*.zip

# Player data & sessions (runtime, contains player IPs - GDPR)
**/Essentials/userdata/
**/playerdata/
**/sessions/
**/usercache.json
**/whitelist.json
**/banned-*.json
**/ops.json

# World data (large binary runtime data)
**/world/
**/world_nether/
**/world_the_end/

# Crash reports & dumps
**/crash-reports/
**/hs_err_*.log
*.hprof

# Plugin JARs (binary files)
**/plugins/*.jar
