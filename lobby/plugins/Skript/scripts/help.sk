# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – Lobby

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (rotierend, alle 10 Minuten) ---
on script load:
    set {lobby_bc_i} to 0

every 10 minutes:
    add 1 to {lobby_bc_i}
    if {lobby_bc_i} is greater than 4:
        set {lobby_bc_i} to 1
    loop all players:
        if {lobby_bc_i} is 1:
            send "&8[&b&lFestas&8] &7Nicht sicher wohin? Nutze &e/navigator &7und wähle zwischen Survival, Skyblock und Mining." to loop-player
        else if {lobby_bc_i} is 2:
            send "&8[&b&lFestas&8] &7Mit &e/guide &7bekommst du einen schnellen Überblick über das Netzwerk und jeden Spielmodus." to loop-player
        else if {lobby_bc_i} is 3:
            send "&8[&b&lFestas&8] &7Öffne mit &e/help &7das Hilfe-Menü, wenn du Regeln, Menüs oder wichtige Befehle suchst." to loop-player
        else:
            send "&8[&b&lFestas&8] &7Survival = Jobs & Tycoon, Skyblock = Inseln & Bazaar, Mining = Minen & Prestige - starte mit &e/navigator&7." to loop-player
