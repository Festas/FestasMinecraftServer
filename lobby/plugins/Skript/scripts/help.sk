# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – Lobby

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (rotierend, alle 10 Minuten, klickbare Links) ---
# Hinweis: Skript unterstützt <link:>/<tooltip:> nativ. Damit die Links wirklich
# anklickbar sind, wird pro Spieler mit "send" verschickt (nicht via broadcast).
on script load:
    set {lobby_bc_i} to 0

every 10 minutes:
    add 1 to {lobby_bc_i}
    if {lobby_bc_i} is greater than 4:
        set {lobby_bc_i} to 1
    loop all players:
        if {lobby_bc_i} is 1:
            send "&8[&b&lFestas&8] &7Alles über das Netzwerk auf unserer &e[<link:https://mc.festas-builds.com><tooltip:Website öffnen>Website<reset>&e]&7." to loop-player
        else if {lobby_bc_i} is 2:
            send "&8[&b&lFestas&8] &7Neu hier? Starte mit den &e[<link:https://mc.festas-builds.com/wiki/erste-schritte/><tooltip:Erste Schritte im Wiki öffnen>Ersten Schritten<reset>&e]&7." to loop-player
        else if {lobby_bc_i} is 3:
            send "&8[&b&lFestas&8] &7Alle Befehle findest du in der &e[<link:https://mc.festas-builds.com/wiki/befehle/><tooltip:Befehls-Übersicht öffnen>Befehls-Übersicht<reset>&e]&7." to loop-player
        else:
            send "&8[&b&lFestas&8] &7Guides & Infos zu allen Servern im &e[<link:https://mc.festas-builds.com/wiki/><tooltip:Zum Wiki>Wiki<reset>&e]&7." to loop-player
