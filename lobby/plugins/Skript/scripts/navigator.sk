# Pfad: plugins/Skript/scripts/navigator.sk
# Lobby Navigator + Hub Protection Script

# --- KONFIGURATION ---
options:
    lobby_world: lobby

# --- 1. NAVIGATOR BEFEHL ---
command /navigator:
    description: Öffnet das Server-Menü
    aliases: /servers, /nav
    trigger:
        execute player command "dm open server_selector"

command /lobby:
    trigger:
        message "&cDu bist bereits auf der Lobby!"

command /rules:
    description: Zeigt die Serverregeln
    trigger:
        execute player command "dm open rules"

command /guide:
    description: Zeigt den Netzwerk-Guide
    aliases: /info, /help2
    trigger:
        execute player command "dm open network_guide"

# --- 2. ALIASES (Direktwahl) ---
command /rpg:
    description: Öffnet die Server-Auswahl (Mining-Server)
    aliases: /mining
    trigger:
        execute player command "dm open server_selector"

command /survival:
    trigger:
        execute player command "dm open server_selector"

command /skyblock:
    trigger:
        execute player command "dm open server_selector"

# --- 3. DAS ITEM MANAGEN (Nur in der Lobby-Welt) ---

function updateNavigator(p: player):
    wait 5 ticks
    if world of {_p} is "{@lobby_world}":
        # Inventar leeren und die festen Lobby-Items setzen
        clear {_p}'s inventory
        # Navigator-Kompass in Slot 4 setzen
        set slot 4 of {_p}'s inventory to compass named "&b&lNavigator &7(Rechtsklick)" with lore "&7Wähle deinen Server"
        # Guide-Buch in Slot 8 setzen
        set slot 8 of {_p}'s inventory to book named "&a&l📖 Netzwerk Guide &7(Rechtsklick)" with lore "&7Lies alles über unser Netzwerk"
        # Spielmodus und Zustand setzen
        set {_p}'s gamemode to adventure
        set {_p}'s hunger to 20
        set {_p}'s saturation to 20
        set {_p}'s health to 20
        heal {_p}
        clear {_p}'s potion effects

    else:
        # Beim Verlassen der Lobby die Netzwerk-Items entfernen
        set {_i4} to slot 4 of {_p}'s inventory
        if {_i4} is compass:
            if name of {_i4} contains "Navigator":
                set slot 4 of {_p}'s inventory to air
        set {_i8} to slot 8 of {_p}'s inventory
        if {_i8} is book:
            if name of {_i8} contains "Guide":
                set slot 8 of {_p}'s inventory to air

# --- EVENTS ---
on join:
    updateNavigator(player)
    # Wetter und Zeit für den Spieler ständig schön halten
    if world of player is "{@lobby_world}":
        set weather in world of player to clear
        set time in world of player to 12:00

on world change:
    updateNavigator(player)

on respawn:
    updateNavigator(player)

on death of player:
    loop drops:
        if loop-value is compass or loop-value is book:
            if name of loop-value contains "Navigator" or name of loop-value contains "Guide":
                remove loop-value from drops

# --- 4. SCHUTZ & INTERAKTION ---

on inventory click:
    if world of player is "{@lobby_world}":
        if index of event-slot is 4 or 8:
            cancel event
        if clicked item is compass or clicked item is book:
            if name of clicked item contains "Navigator" or name of clicked item contains "Guide":
                cancel event

on drop:
    if world of player is "{@lobby_world}":
        cancel event

on pickup:
    if world of player is "{@lobby_world}":
        cancel event

on click:
    if world of player is "{@lobby_world}":
        if player's tool is compass:
            if name of player's tool contains "Navigator":
                cancel event
                execute player command "navigator"
        else if player's tool is book:
            if name of player's tool contains "Guide":
                cancel event
                execute player command "guide"

# --- 5. DOPPELSPRUNG (Double-Jump) ---

on toggle flight:
    if world of player is "{@lobby_world}":
        if player's gamemode is adventure:
            cancel event
            set {_v} to player's velocity
            set y component of {_v} to 1.0
            set player's velocity to {_v}
            play sound "entity.firework_rocket.launch" with volume 0.5 and pitch 1.5 at player for player
            set player's flight mode to false
            wait 40 ticks
            if world of player is "{@lobby_world}":
                if player's gamemode is adventure:
                    set player's flight mode to true

on join:
    if world of player is "{@lobby_world}":
        set player's flight mode to true

# --- 6. HUNGER & SCHADEN SCHUTZ ---

on hunger meter change:
    if world of player is "{@lobby_world}":
        cancel event

on damage of player:
    if world of victim is "{@lobby_world}":
        cancel event