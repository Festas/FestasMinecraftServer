# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – RPG/Mining

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (rotierend, alle 10 Minuten, klickbare Links) ---
# Hinweis: Skript unterstützt <link:>/<tooltip:> nativ. Damit die Links wirklich
# anklickbar sind, wird pro Spieler mit "send" verschickt (nicht via broadcast).
on script load:
    set {mining_bc_i} to 0

every 10 minutes:
    add 1 to {mining_bc_i}
    if {mining_bc_i} is greater than 4:
        set {mining_bc_i} to 1
    loop all players:
        if {mining_bc_i} is 1:
            send "&8[&b&lMining&8] &7Nicht sicher wie du anfängst? Lies die &e[<link:https://mc.festas-builds.com/wiki/erste-schritte/><tooltip:Erste Schritte im Wiki öffnen>Ersten Schritte<reset>&e]&7 oder tippe &e/help&7." to loop-player
        else if {mining_bc_i} is 2:
            send "&8[&b&lMining&8] &7Alle Befehle findest du in der &e[<link:https://mc.festas-builds.com/wiki/befehle/><tooltip:Befehls-Übersicht öffnen>Befehls-Übersicht<reset>&e]&7." to loop-player
        else if {mining_bc_i} is 3:
            send "&8[&b&lMining&8] &7Sieh dir die Minen-Welt live auf der &e[<link:https://mining.festas-builds.com><tooltip:Mining Live-Karte öffnen>Live-Karte<reset>&e]&7 an." to loop-player
        else:
            send "&8[&b&lMining&8] &7Infos zu Zonen, Rankup & Prestige gibt es im &e[<link:https://mc.festas-builds.com/wiki/><tooltip:Zum Wiki>Wiki<reset>&e]&7." to loop-player
