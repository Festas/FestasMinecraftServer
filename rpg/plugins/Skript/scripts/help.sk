# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – RPG/Mining

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (alle 10 Minuten) ---
every 10 minutes:
    broadcast "&8[&b&lMining&8] &7Nicht sicher wie du anfängst? Tippe &e/help &7für eine Übersicht über Zonen, Rankup und mehr!"
