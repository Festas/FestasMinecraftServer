# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – RPG/Mining

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (rotierend, alle 10 Minuten) ---
on script load:
    set {mining_bc_i} to 0

every 10 minutes:
    add 1 to {mining_bc_i}
    if {mining_bc_i} is greater than 8:
        set {mining_bc_i} to 1
    loop all players:
        if {mining_bc_i} is 1:
            send "&8[&b&lMining&8] &7Neu auf Mining? Öffne mit &e/help &7oder &e/nav &7das Hilfe-Menü - alle Features zentral in &e/features&7." to loop-player
        else if {mining_bc_i} is 2:
            send "&8[&b&lMining&8] &7Bleib täglich dran: hol dir &e/daily &7und erledige deine &e/quests&7." to loop-player
        else if {mining_bc_i} is 3:
            send "&8[&b&lMining&8] &7Kern-Progression: &e/rankup &7schaltet Zonen frei, danach &e/prestige &7und später &e/rebirth&7." to loop-player
        else if {mining_bc_i} is 4:
            send "&8[&b&lMining&8] &7Sammle BattlePass-Fortschritt und hol deine Belohnungen mit &e/bp &7ab." to loop-player
        else if {mining_bc_i} is 5:
            send "&8[&b&lMining&8] &7Rüste auf: verzaubere deine Spitzhacke mit &e/enchantmenu &7und nutze den &e/autominer&7." to loop-player
        else if {mining_bc_i} is 6:
            send "&8[&b&lMining&8] &7Wirtschaft: verwalte &e/tokens &7& &e/gems &7und finde Deals im &e/blackmarket&7." to loop-player
        else if {mining_bc_i} is 7:
            send "&8[&b&lMining&8] &7Mit &e/pmine &7baust du in deiner eigenen Mine in Ruhe ab und baust sie aus." to loop-player
        else:
            send "&8[&b&lMining&8] &7Gemeinsam mehr erreichen: gründe eine &e/gang &7und sichere Zusatz-Einkommen mit &e/robots&7." to loop-player
