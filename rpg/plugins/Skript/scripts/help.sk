# Pfad: plugins/Skript/scripts/help.sk
# /help Befehl + regelmäßiger Broadcast – RPG/Mining

# --- /help BEFEHL ---
command /help:
    description: Öffnet das Hilfe-Menü
    aliases: /hilfe
    trigger:
        execute player command "dm open help_menu"

# --- AUTO-BROADCAST (rotierend, alle 10 Minuten) ---
on script load:
    set {mining_bc_i} to 0

every 10 minutes:
    add 1 to {mining_bc_i}
    if {mining_bc_i} is greater than 4:
        set {mining_bc_i} to 1
    loop all players:
        if {mining_bc_i} is 1:
            send "&8[&b&lMining&8] &7Neu auf Mining? Öffne mit &e/help &7oder &e/nav &7das Hilfe-Menü und starte in &e/mine&7." to loop-player
        else if {mining_bc_i} is 2:
            send "&8[&b&lMining&8] &7Hol dir mit &e/daily &7deine Belohnung, baue in &e/mine &7und lies &e/tips &7für den nächsten Schritt." to loop-player
        else if {mining_bc_i} is 3:
            send "&8[&b&lMining&8] &7Wenn genug Geld da ist, schaltet &e/rankup &7neue Zonen frei - später wartet &e/prestige&7." to loop-player
        else:
            send "&8[&b&lMining&8] &7Mit &e/pmine &7baust du in deiner eigenen Mine. Alle Basics findest du jederzeit im Hilfe-Menü." to loop-player
