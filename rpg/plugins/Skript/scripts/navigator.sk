# --- KONFIGURATION ---
# WICHTIG: Hier KEINE Anführungszeichen nutzen!
options:
    lobby_server: lobby

# --- BEFEHL ---
command /lobby:
    description: Teleportiert dich zur Lobby
    aliases: /l, /hub, /lob
    trigger:
        message "&7Du wirst zur &bLobby &7gesendet..."
        
        # Methode 1: BungeeCord Command (benötigt SkQuery/SkBee)
        # Da wir die Anführungszeichen oben entfernt haben, wird hier jetzt "lobby" draus.
        connect player to server "{@lobby_server}"

# --- FALLBACK ---
# Falls der "connect"-Befehl oben nicht geht (weil Addon fehlt), 
# kann man diesen Command nutzen, den Velocity abfängt.

command /server <text>:
    trigger:
        stop
        
command /warpmenu:
    aliases: /wm, /warpm
    trigger:
        make player execute command "/dm open warps"

# --- NAVIGATIONS- / HILFE-MENÜ ---
command /nav:
    description: Öffnet das Navigations- & Hilfe-Menü
    aliases: /navigator
    trigger:
        make player execute command "/dm open help_menu"

# --- SERVER-TIPPS ---
command /tips:
    description: Zeigt einen zufälligen Mining-Tipp
    aliases: /tipp, /tip
    trigger:
        miningTip(player)

function miningTip(p: player):
    delete {_tips::*}
    add "&7Starte in den &e/mine &7Zonen und hole dir davor deine Belohnung mit &e/daily&7." to {_tips::*}
    add "&7Gib dein Geld für &e/rankup &7aus und schalte bessere Zonen frei." to {_tips::*}
    add "&7Am höchsten Rang angekommen? Steig mit &e/prestige &7auf für Multiplikatoren!" to {_tips::*}
    add "&7Werte deine &bSpitzhacke &7auf für mehr Blöcke pro Schlag & starke Enchants." to {_tips::*}
    add "&7Schalte deine eigene &d/pmine &7(Private Mine) frei und baue ungestört ab." to {_tips::*}
    add "&7Prüfe deinen Fortschritt mit &e/ranks &7und dein Guthaben mit &e/bal&7." to {_tips::*}
    add "&7Seltene Enchants findest du in Kisten und bei Events – halte die Augen offen!" to {_tips::*}
    add "&7Nutze &e/nav &7oder den &bNetzwerk-Kompass&7, um das Hilfe-Menü jederzeit zu öffnen." to {_tips::*}
    set {_tip} to random element out of {_tips::*}
    send "&8[&b&lMining&8] &7Tipp: %{_tip}%" to {_p}

# --- NETZWERK-KOMPASS GEBEN (nicht-destruktiv) ---
on join:
    wait 15 ticks
    ensureCompass(player)
    wait 3 seconds
    miningTip(player)

on respawn:
    wait 10 ticks
    ensureCompass(player)

function ensureCompass(p: player):
    # Prüfen, ob der Spieler bereits einen Netzwerk-Kompass besitzt
    set {_has} to false
    loop 36 times:
        set {_idx} to loop-number - 1
        set {_it} to slot {_idx} of {_p}'s inventory
        if {_it} is compass:
            if name of {_it} contains "Netzwerk-Kompass":
                set {_has} to true
    if {_has} is false:
        set {_kompass} to compass named "&b&l🧭 Netzwerk-Kompass &7(Rechtsklick)" with lore "&7Öffnet Navigation, Warps & Tipps" and "&7Rechtsklick zum Öffnen"
        if slot 8 of {_p}'s inventory is air:
            set slot 8 of {_p}'s inventory to {_kompass}
        else:
            give {_kompass} to {_p}

# --- INTERAKTION MIT DEM KOMPASS ---
on right click:
    if player's tool is compass:
        if name of player's tool contains "Netzwerk-Kompass":
            cancel event
            make player execute command "/dm open help_menu"

on drop:
    if name of event-item contains "Netzwerk-Kompass":
        cancel event
        send "&8[&b&lMining&8] &7Deinen &bNetzwerk-Kompass &7kannst du nicht wegwerfen." to player