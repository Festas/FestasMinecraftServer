# ============================================================
#  PvP Arena System — RPG Server
#  Befehle: /arena, /arena join, /arena leave, /arena top
# ============================================================

options:
    prefix: &c&l⚔ Arena &8» &r
    default_elo: 1000
    elo_k_factor: 32
    win_coins: 50
    loss_coins: 10
    countdown_seconds: 5
    min_elo: 100

# ============================================================
#  Hilfsfunktionen
# ============================================================

function arenaEloChange(winnerElo: number, loserElo: number) :: number:
    set {_expected} to 1 / (1 + 10 ^ (({_loserElo} - {_winnerElo}) / 400))
    set {_change} to ceil({@elo_k_factor} * (1 - {_expected}))
    return {_change}

function arenaRankTitle(elo: number) :: text:
    if {_elo} >= 2500:
        return "&4&lGroßmeister"
    else if {_elo} >= 2000:
        return "&c&lMeister"
    else if {_elo} >= 1750:
        return "&5Diamant"
    else if {_elo} >= 1500:
        return "&bPlatin"
    else if {_elo} >= 1250:
        return "&6Gold"
    else if {_elo} >= 1000:
        return "&7Silber"
    else if {_elo} >= 750:
        return "&8Bronze"
    return "&7Eisen"

function arenaQueueSize(type: text) :: number:
    set {_count} to 0
    loop {arena.queue.%{_type}%::*}:
        add 1 to {_count}
    return {_count}

function arenaRequiredPlayers(type: text) :: number:
    if {_type} is "1v1":
        return 2
    else if {_type} is "2v2":
        return 4
    else if {_type} is "3v3":
        return 6
    return 2

function removeFromAllQueues(p: player):
    remove "%player%" from {arena.queue.1v1::*}
    remove "%player%" from {arena.queue.2v2::*}
    remove "%player%" from {arena.queue.3v3::*}
    delete {arena.%{_p}%.queued}

function savePlayerState(p: player):
    set {arena.%{_p}%.saved.location} to location of {_p}
    set {arena.%{_p}%.saved.health} to health of {_p}
    set {arena.%{_p}%.saved.hunger} to food level of {_p}
    set {arena.%{_p}%.saved.level} to level of {_p}
    set {arena.%{_p}%.saved.xp} to {_p}'s exp

function restorePlayerState(p: player):
    if {arena.%{_p}%.saved.location} is set:
        teleport {_p} to {arena.%{_p}%.saved.location}
    set health of {_p} to {arena.%{_p}%.saved.health} ? 20
    set food level of {_p} to {arena.%{_p}%.saved.hunger} ? 20
    set level of {_p} to {arena.%{_p}%.saved.level} ? 0
    set {_p}'s exp to {arena.%{_p}%.saved.xp} ? 0
    delete {arena.%{_p}%.saved.location}
    delete {arena.%{_p}%.saved.health}
    delete {arena.%{_p}%.saved.hunger}
    delete {arena.%{_p}%.saved.level}
    delete {arena.%{_p}%.saved.xp}

function openArenaMenu(p: player):
    set {_gui} to chest inventory with 3 rows named "&c&l⚔ Arena-Menü"
    set {_elo} to {arena.%{_p}%.elo} ? {@default_elo}
    set {_rank} to arenaRankTitle({_elo})
    set {_wins} to {arena.%{_p}%.wins} ? 0
    set {_losses} to {arena.%{_p}%.losses} ? 0
    set {_kills} to {arena.%{_p}%.kills} ? 0
    set {_deaths} to {arena.%{_p}%.deaths} ? 0

    # Player stats
    set slot 4 of {_gui} to player head named "&e&l%{_p}%'s Statistiken" with lore "&7ELO: &e%{_elo}%", "&7Rang: %{_rank}%", "&7Siege: &a%{_wins}%", "&7Niederlagen: &c%{_losses}%", "&7Kills: &6%{_kills}%" and "&7Tode: &4%{_deaths}%"

    # 1v1 Queue
    set {_q1} to arenaQueueSize("1v1")
    set slot 10 of {_gui} to iron sword named "&c&l1v1 Duell" with lore "&7Trete in ein Einzelduell ein!", "", "&7Spieler in Warteschlange: &e%{_q1}%", "" and "&a▶ Klicke zum Beitreten"

    # 2v2 Queue
    set {_q2} to arenaQueueSize("2v2")
    set slot 12 of {_gui} to diamond sword named "&c&l2v2 Team-Duell" with lore "&7Kämpfe im 2er-Team!", "", "&7Spieler in Warteschlange: &e%{_q2}%", "" and "&a▶ Klicke zum Beitreten"

    # 3v3 Queue
    set {_q3} to arenaQueueSize("3v3")
    set slot 14 of {_gui} to netherite sword named "&c&l3v3 Teamkampf" with lore "&7Großer Teamkampf!", "", "&7Spieler in Warteschlange: &e%{_q3}%", "" and "&a▶ Klicke zum Beitreten"

    # Leaderboard
    set slot 16 of {_gui} to gold block named "&6&lBestenliste" with lore "&7Zeige die Top-Spieler", "" and "&a▶ Klicke zum Anzeigen"

    open {_gui} to {_p}

function startArenaCountdown(type: text, players: objects):
    loop {_players::*}:
        set {_p} to loop-value parsed as player
        if {_p} is online:
            send "{@prefix}&eDer Kampf beginnt in &c{@countdown_seconds} Sekunden&e!" to {_p}
            set {arena.%{_p}%.in_match} to true

    set {_i} to {@countdown_seconds}
    while {_i} > 0:
        loop {_players::*}:
            set {_p} to loop-value parsed as player
            if {_p} is online:
                send title "&c&l%{_i}%" with subtitle "&7Mach dich bereit!" to {_p} for 1 second
                play sound "block.note_block.hat" with volume 1 and pitch 1 to {_p}
        wait 1 second
        remove 1 from {_i}

    loop {_players::*}:
        set {_p} to loop-value parsed as player
        if {_p} is online:
            send title "&a&lKÄMPFE!" with subtitle "" to {_p} for 1 second
            play sound "entity.ender_dragon.growl" with volume 1 and pitch 1.5 to {_p}

function tryStartMatch(type: text):
    set {_required} to arenaRequiredPlayers({_type})
    set {_current} to arenaQueueSize({_type})
    if {_current} >= {_required}:
        set {_matchPlayers::*} to first {_required} elements of {arena.queue.%{_type}%::*}
        loop {_matchPlayers::*}:
            remove loop-value from {arena.queue.%{_type}%::*}

        # Generate match ID
        set {_matchId} to "%now%_%{_type}%"
        replace all " " in {_matchId} with "_"
        replace all ":" in {_matchId} with ""
        replace all "/" in {_matchId} with ""

        # Assign teams
        if {_type} is "1v1":
            set {arena.match.%{_matchId}%.team1::1} to {_matchPlayers::1}
            set {arena.match.%{_matchId}%.team2::1} to {_matchPlayers::2}
        else if {_type} is "2v2":
            set {arena.match.%{_matchId}%.team1::1} to {_matchPlayers::1}
            set {arena.match.%{_matchId}%.team1::2} to {_matchPlayers::2}
            set {arena.match.%{_matchId}%.team2::1} to {_matchPlayers::3}
            set {arena.match.%{_matchId}%.team2::2} to {_matchPlayers::4}
        else if {_type} is "3v3":
            set {arena.match.%{_matchId}%.team1::1} to {_matchPlayers::1}
            set {arena.match.%{_matchId}%.team1::2} to {_matchPlayers::2}
            set {arena.match.%{_matchId}%.team1::3} to {_matchPlayers::3}
            set {arena.match.%{_matchId}%.team2::1} to {_matchPlayers::4}
            set {arena.match.%{_matchId}%.team2::2} to {_matchPlayers::5}
            set {arena.match.%{_matchId}%.team2::3} to {_matchPlayers::6}

        set {arena.match.%{_matchId}%.type} to {_type}
        set {arena.match.%{_matchId}%.active} to true

        loop {_matchPlayers::*}:
            set {_p} to loop-value parsed as player
            if {_p} is online:
                set {arena.%{_p}%.match} to {_matchId}
                delete {arena.%{_p}%.queued}
                savePlayerState({_p})
                set health of {_p} to 20
                set food level of {_p} to 20
                send "{@prefix}&a&lMatch gefunden! &eModus: &c%{_type}%" to {_p}

        startArenaCountdown({_type}, {_matchPlayers::*})

# ============================================================
#  Befehle
# ============================================================

command /arena [<text = "menu">] [<text>]:
    trigger:
        if arg-1 is "menu" or "gui":
            openArenaMenu(player)

        else if arg-1 is "join" or "beitreten":
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /arena join <1v1|2v2|3v3>"
                stop
            set {_type} to arg-2 in lower case
            if {_type} is not "1v1", "2v2" or "3v3":
                send "{@prefix}&cUngültiger Modus! Verfügbar: 1v1, 2v2, 3v3"
                stop
            if {arena.%player%.queued} is set:
                send "{@prefix}&cDu bist bereits in einer Warteschlange!"
                send "{@prefix}&7Nutze &e/arena leave &7um sie zu verlassen."
                stop
            if {arena.%player%.in_match} is true:
                send "{@prefix}&cDu bist bereits in einem Kampf!"
                stop

            add "%player%" to {arena.queue.%{_type}%::*}
            set {arena.%player%.queued} to {_type}
            set {_queueSize} to arenaQueueSize({_type})
            set {_required} to arenaRequiredPlayers({_type})
            send "{@prefix}&aDu bist der &e%{_type}%&a-Warteschlange beigetreten!"
            send "{@prefix}&7Spieler: &e%{_queueSize}%&7/&e%{_required}%"
            play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 to player

            tryStartMatch({_type})

        else if arg-1 is "leave" or "verlassen":
            if {arena.%player%.in_match} is true:
                send "{@prefix}&cDu kannst einen laufenden Kampf nicht verlassen!"
                send "{@prefix}&7Der Kampf wird als Niederlage gewertet."
                stop
            if {arena.%player%.queued} is not set:
                send "{@prefix}&cDu bist in keiner Warteschlange!"
                stop
            set {_type} to {arena.%player%.queued}
            removeFromAllQueues(player)
            send "{@prefix}&eDu hast die &c%{_type}%&e-Warteschlange verlassen."

        else if arg-1 is "top" or "bestenliste":
            send ""
            send "{@prefix}&6&lELO-Bestenliste:"
            send ""
            set {_count} to 0
            loop {arena.leaderboard::*}:
                add 1 to {_count}
                if {_count} > 10:
                    stop
                set {_uuid} to loop-value
                set {_pElo} to {arena.%{_uuid}%.elo} ? {@default_elo}
                set {_pName} to {arena.%{_uuid}%.name} ? "Unbekannt"
                set {_pWins} to {arena.%{_uuid}%.wins} ? 0
                set {_pRank} to arenaRankTitle({_pElo})
                if {_count} is 1:
                    send "  &6&l#1 &e%{_pName}% &8- &e%{_pElo}% ELO %{_pRank}% &8(&a%{_pWins}%W&8)"
                else if {_count} is 2:
                    send "  &7&l#2 &e%{_pName}% &8- &e%{_pElo}% ELO %{_pRank}% &8(&a%{_pWins}%W&8)"
                else if {_count} is 3:
                    send "  &c&l#3 &e%{_pName}% &8- &e%{_pElo}% ELO %{_pRank}% &8(&a%{_pWins}%W&8)"
                else:
                    send "  &7#%{_count}% &e%{_pName}% &8- &e%{_pElo}% ELO %{_pRank}% &8(&a%{_pWins}%W&8)"
            if {_count} is 0:
                send "  &7Noch keine Einträge!"
            send ""

        else if arg-1 is "stats" or "statistiken":
            set {_elo} to {arena.%player%.elo} ? {@default_elo}
            set {_rank} to arenaRankTitle({_elo})
            set {_wins} to {arena.%player%.wins} ? 0
            set {_losses} to {arena.%player%.losses} ? 0
            set {_kills} to {arena.%player%.kills} ? 0
            set {_deaths} to {arena.%player%.deaths} ? 0
            set {_winrate} to 0
            if ({_wins} + {_losses}) > 0:
                set {_winrate} to floor({_wins} / ({_wins} + {_losses}) * 100)
            send ""
            send "{@prefix}&eDeine Arena-Statistiken:"
            send "  &7ELO: &e%{_elo}%"
            send "  &7Rang: %{_rank}%"
            send "  &7Siege: &a%{_wins}% &8| &7Niederlagen: &c%{_losses}%"
            send "  &7Winrate: &e%{_winrate}%%%"
            send "  &7Kills: &6%{_kills}% &8| &7Tode: &4%{_deaths}%"
            send ""

        else:
            send "{@prefix}&eArena-Befehle:"
            send "  &c/arena &8- &7Öffnet das Arena-Menü"
            send "  &c/arena join <Typ> &8- &7Tritt einer Warteschlange bei"
            send "  &c/arena leave &8- &7Verlasse die Warteschlange"
            send "  &c/arena stats &8- &7Zeige deine Statistiken"
            send "  &c/arena top &8- &7ELO-Bestenliste"

# ============================================================
#  GUI-Klick-Handler
# ============================================================

on inventory click:
    if name of event-inventory is "&c&l⚔ Arena-Menü":
        cancel event
        if name of event-slot contains "1v1 Duell":
            close player's inventory
            make player execute command "/arena join 1v1"
        else if name of event-slot contains "2v2 Team-Duell":
            close player's inventory
            make player execute command "/arena join 2v2"
        else if name of event-slot contains "3v3 Teamkampf":
            close player's inventory
            make player execute command "/arena join 3v3"
        else if name of event-slot contains "Bestenliste":
            close player's inventory
            make player execute command "/arena top"

# ============================================================
#  Arena-Kill/Tod-Tracking
# ============================================================

on death of player:
    if {arena.%victim%.in_match} is true:
        set {_matchId} to {arena.%victim%.match}
        set {_killer} to attacker
        if {_killer} is a player:
            if {arena.%{_killer}%.in_match} is true:
                # Kill tracking
                add 1 to {arena.%{_killer}%.kills}
                add 1 to {arena.%victim%.deaths}
                send "{@prefix}&6%{_killer}% &ehat &c%victim% &egetötet!" to {_killer}

        # Check if match is over (all team members dead)
        set {_victimTeam} to "none"
        loop {arena.match.%{_matchId}%.team1::*}:
            if loop-value is "%victim%":
                set {_victimTeam} to "team1"
        loop {arena.match.%{_matchId}%.team2::*}:
            if loop-value is "%victim%":
                set {_victimTeam} to "team2"

        set {arena.match.%{_matchId}%.%victim%.dead} to true

        # Check if entire team is dead
        set {_allDead} to true
        if {_victimTeam} is "team1":
            loop {arena.match.%{_matchId}%.team1::*}:
                set {_member} to loop-value parsed as player
                if {arena.match.%{_matchId}%.%{_member}%.dead} is not true:
                    set {_allDead} to false
            if {_allDead} is true:
                endArenaMatch({_matchId}, "team2")
        else if {_victimTeam} is "team2":
            loop {arena.match.%{_matchId}%.team2::*}:
                set {_member} to loop-value parsed as player
                if {arena.match.%{_matchId}%.%{_member}%.dead} is not true:
                    set {_allDead} to false
            if {_allDead} is true:
                endArenaMatch({_matchId}, "team1")

function endArenaMatch(matchId: text, winningTeam: text):
    if {arena.match.%{_matchId}%.active} is not true:
        return
    set {arena.match.%{_matchId}%.active} to false

    if {_winningTeam} is "team1":
        set {_losingTeam} to "team2"
    else:
        set {_losingTeam} to "team1"

    # Process winners
    loop {arena.match.%{_matchId}%.%{_winningTeam}%::*}:
        set {_p} to loop-value parsed as player
        if {_p} is online:
            set {_elo} to {arena.%{_p}%.elo} ? {@default_elo}
            # Calculate average opponent ELO
            set {_oppElo} to {@default_elo}
            loop {arena.match.%{_matchId}%.%{_losingTeam}%::*}:
                set {_opp} to loop-value-2 parsed as player
                set {_oppElo} to {arena.%{_opp}%.elo} ? {@default_elo}
            set {_eloGain} to arenaEloChange({_elo}, {_oppElo})
            add {_eloGain} to {arena.%{_p}%.elo}
            add 1 to {arena.%{_p}%.wins}
            set {arena.%{_p}%.name} to name of {_p}
            delete {arena.%{_p}%.in_match}
            delete {arena.%{_p}%.match}
            send "" to {_p}
            send "{@prefix}&a&l✦ SIEG! ✦" to {_p}
            send "{@prefix}&eELO: &a+%{_eloGain}% &7(%{arena.%{_p}%.elo}%)" to {_p}
            send "{@prefix}&eBelohnung: &6+{@win_coins} Münzen" to {_p}
            send "" to {_p}
            play sound "ui.toast.challenge_complete" with volume 1 and pitch 1 to {_p}
            # Add coins (integration point with economy)
            execute console command "eco give %{_p}% {@win_coins}"
            wait 3 seconds
            restorePlayerState({_p})

            # Update leaderboard
            if {arena.leaderboard::*} does not contain "%{_p}%":
                add "%{_p}%" to {arena.leaderboard::*}

    # Process losers
    loop {arena.match.%{_matchId}%.%{_losingTeam}%::*}:
        set {_p} to loop-value parsed as player
        if {_p} is online:
            set {_elo} to {arena.%{_p}%.elo} ? {@default_elo}
            set {_oppElo} to {@default_elo}
            loop {arena.match.%{_matchId}%.%{_winningTeam}%::*}:
                set {_opp} to loop-value-2 parsed as player
                set {_oppElo} to {arena.%{_opp}%.elo} ? {@default_elo}
            set {_eloLoss} to arenaEloChange({_oppElo}, {_elo})
            subtract {_eloLoss} from {arena.%{_p}%.elo}
            if {arena.%{_p}%.elo} < {@min_elo}:
                set {arena.%{_p}%.elo} to {@min_elo}
            add 1 to {arena.%{_p}%.losses}
            set {arena.%{_p}%.name} to name of {_p}
            delete {arena.%{_p}%.in_match}
            delete {arena.%{_p}%.match}
            send "" to {_p}
            send "{@prefix}&c&l✖ NIEDERLAGE ✖" to {_p}
            send "{@prefix}&eELO: &c-%{_eloLoss}% &7(%{arena.%{_p}%.elo}%)" to {_p}
            send "{@prefix}&eTrostpreis: &6+{@loss_coins} Münzen" to {_p}
            send "" to {_p}
            play sound "entity.wither.death" with volume 0.5 and pitch 0.8 to {_p}
            execute console command "eco give %{_p}% {@loss_coins}"
            wait 3 seconds
            restorePlayerState({_p})

            if {arena.leaderboard::*} does not contain "%{_p}%":
                add "%{_p}%" to {arena.leaderboard::*}

    # Cleanup match data
    wait 5 seconds
    delete {arena.match.%{_matchId}%.*}

# ============================================================
#  Spieler-Quit während Match/Queue
# ============================================================

on quit:
    if {arena.%player%.queued} is set:
        removeFromAllQueues(player)
    if {arena.%player%.in_match} is true:
        # Count as loss
        add 1 to {arena.%player%.losses}
        set {_elo} to {arena.%player%.elo} ? {@default_elo}
        subtract 25 from {arena.%player%.elo}
        if {arena.%player%.elo} < {@min_elo}:
            set {arena.%player%.elo} to {@min_elo}
        delete {arena.%player%.in_match}
        set {_matchId} to {arena.%player%.match}
        if {_matchId} is set:
            set {arena.match.%{_matchId}%.%player%.dead} to true
        delete {arena.%player%.match}

# ============================================================
#  Admin-Befehle
# ============================================================

command /arenaadmin <text> [<player>] [<number>]:
    permission: arena.admin
    permission message: {@prefix}&cKeine Berechtigung!
    trigger:
        if arg-1 is "setelo":
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /arenaadmin setelo <Spieler> <ELO>"
                stop
            if arg-3 is not set:
                send "{@prefix}&cNutzung: /arenaadmin setelo <Spieler> <ELO>"
                stop
            set {arena.%arg-2%.elo} to arg-3
            set {arena.%arg-2%.name} to name of arg-2
            send "{@prefix}&aELO von %arg-2% auf &e%arg-3% &agesetzt."

        else if arg-1 is "reset":
            if arg-2 is not set:
                send "{@prefix}&cNutzung: /arenaadmin reset <Spieler>"
                stop
            set {arena.%arg-2%.elo} to {@default_elo}
            set {arena.%arg-2%.wins} to 0
            set {arena.%arg-2%.losses} to 0
            set {arena.%arg-2%.kills} to 0
            set {arena.%arg-2%.deaths} to 0
            send "{@prefix}&aStatistiken von %arg-2% zurückgesetzt."

        else if arg-1 is "clearqueue":
            clear {arena.queue.1v1::*}
            clear {arena.queue.2v2::*}
            clear {arena.queue.3v3::*}
            send "{@prefix}&aAlle Warteschlangen geleert."

        else:
            send "{@prefix}&eAdmin-Befehle:"
            send "  &c/arenaadmin setelo <Spieler> <ELO>"
            send "  &c/arenaadmin reset <Spieler>"
            send "  &c/arenaadmin clearqueue"
