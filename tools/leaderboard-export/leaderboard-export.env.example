# leaderboard-export – database credentials (EXAMPLE)
#
# Copy this file to a host-only location that is NEVER committed, e.g.
#   /opt/leaderboard-export/leaderboard-export.env
# and lock it down:
#   chown deploy:deploy /opt/leaderboard-export/leaderboard-export.env
#   chmod 600           /opt/leaderboard-export/leaderboard-export.env
#
# In production these values are injected from TWO GitHub secrets by
# .github/workflows/deploy-leaderboard-export.yml – see README.md:
#   * PLAN_RO_DB_ENV      → PLAN_RO_DB_*      (SELECT on s4_plan)
#   * LUCKPERMS_RO_DB_ENV → LUCKPERMS_RO_DB_* (SELECT on s4_perms)
#
# Use DEDICATED READ-ONLY users (SELECT only). Do NOT reuse Plan's or LuckPerms'
# read/write users (least privilege, see docs/infrastructure/DATENBANKEN.md).

# --- Playtime source: Plan (s4_plan) -----------------------------------------
# Required
PLAN_RO_DB_USER=CHANGE_ME
PLAN_RO_DB_PASSWORD=CHANGE_ME

# Optional overrides (defaults come from config.json / the script)
#PLAN_RO_DB_HOST=172.25.0.1
#PLAN_RO_DB_PORT=3306
#PLAN_RO_DB_DATABASE=s4_plan
#PLAN_RO_DB_SSL=true
# Path to a CA certificate to verify the MariaDB server certificate. When set,
# certificate verification is enabled; when unset, TLS is negotiated without
# pinning an internal self-signed CA.
#PLAN_RO_DB_SSL_CA=/etc/ssl/certs/mariadb-ca.pem
#PLAN_RO_DB_SSL_VERIFY=true
#PLAN_RO_DB_CONNECT_TIMEOUT=5
# Read timeout for the playtime aggregation (SUM/GROUP BY over plan_sessions).
# Larger than the connect timeout so a big session history is not killed early.
#PLAN_RO_DB_READ_TIMEOUT=30

# --- Rank source: LuckPerms (s4_perms) ---------------------------------------
# Required
LUCKPERMS_RO_DB_USER=CHANGE_ME
LUCKPERMS_RO_DB_PASSWORD=CHANGE_ME

# Optional overrides (defaults come from config.json / the script)
#LUCKPERMS_RO_DB_HOST=172.25.0.1
#LUCKPERMS_RO_DB_PORT=3306
#LUCKPERMS_RO_DB_DATABASE=s4_perms
#LUCKPERMS_RO_DB_SSL=true
#LUCKPERMS_RO_DB_SSL_CA=/etc/ssl/certs/mariadb-ca.pem
#LUCKPERMS_RO_DB_SSL_VERIFY=true
#LUCKPERMS_RO_DB_CONNECT_TIMEOUT=5
#LUCKPERMS_RO_DB_READ_TIMEOUT=30

# Override the output file (defaults to config.json -> output)
#LEADERBOARD_OUTPUT=/home/deploy/minecraft-website/data/leaderboard.json
