# plan-players-export – database credentials (EXAMPLE)
#
# Copy this file to a host-only location that is NEVER committed, e.g.
#   /opt/plan-players-export/plan-players-export.env
# and lock it down:
#   chown deploy:deploy /opt/plan-players-export/plan-players-export.env
#   chmod 600           /opt/plan-players-export/plan-players-export.env
#
# In production these values are injected from the GitHub secret PLAN_RO_DB_ENV
# by .github/workflows/deploy-plan-players-export.yml – see README.md.
#
# Use a DEDICATED READ-ONLY user (SELECT only on s4_plan). Do NOT reuse Plan's
# read/write user (least privilege, see docs/infrastructure/DATENBANKEN.md).

# Required
PLAN_RO_DB_USER=CHANGE_ME
PLAN_RO_DB_PASSWORD=CHANGE_ME

# Optional overrides (defaults come from config.json / the script)
#PLAN_RO_DB_HOST=172.25.0.1
#PLAN_RO_DB_PORT=3306
#PLAN_RO_DB_DATABASE=s4_plan
#PLAN_RO_DB_SSL=true
# Path to a CA certificate to verify the MariaDB server certificate. When set,
# certificate verification is enabled; when unset, TLS is negotiated without
# pinning an internal self-signed CA.
#PLAN_RO_DB_SSL_CA=/etc/ssl/certs/mariadb-ca.pem
#PLAN_RO_DB_SSL_VERIFY=true
#PLAN_RO_DB_CONNECT_TIMEOUT=5

# Override the output file (defaults to config.json -> output)
#PLAN_PLAYERS_OUTPUT=/home/deploy/minecraft-website/data/players.json
