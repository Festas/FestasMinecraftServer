# economy-export – database credentials (EXAMPLE)
#
# Copy this file to a host-only location that is NEVER committed, e.g.
#   /opt/economy-export/economy-export.env
# and lock it down:
#   chown deploy:deploy /opt/economy-export/economy-export.env
#   chmod 600           /opt/economy-export/economy-export.env
#
# In production these values are injected from GitHub secrets by
# .github/workflows/deploy-economy-export.yml – see README.md:
#   * CMI_SURVIVAL_DB_ENV → CMI_SURVIVAL_DB_* (SELECT on the survival CMI database)
#   * CMI_MINING_DB_ENV   → CMI_MINING_DB_*   (SELECT on the mining CMI database)
#   * CMI_SKYBLOCK_DB_ENV → CMI_SKYBLOCK_DB_* (SELECT on the skyblock CMI database)
#   * LUCKPERMS_RO_DB_ENV → LUCKPERMS_RO_DB_* (SELECT on s4_perms)
#
# Use DEDICATED READ-ONLY users (SELECT only) if you want strict least privilege,
# or the same per-server CMI user (see below). See docs/infrastructure/DATENBANKEN.md.
#
# NOTE: CMI must be switched to MySQL storage per server first, each writing to
# its OWN database (CMI warns servers must never share a table). This is already
# wired in the repo: <server>/plugins/CMI/Settings/DataBaseInfo.yml uses
# method: MySQL and the deploy-<server> workflows inject the DB user from the
# CMI_<SERVER>_DB_ENV secrets. The SAME per-server secret is used by this exporter
# to read balances. See README.md and docs/infrastructure/DATENBANKEN.md.

# --- Balance source: Survival CMI --------------------------------------------
# Required
CMI_SURVIVAL_DB_USER=CHANGE_ME
CMI_SURVIVAL_DB_PASSWORD=CHANGE_ME
# Optional overrides (defaults come from config.json / the script)
#CMI_SURVIVAL_DB_HOST=172.25.0.1
#CMI_SURVIVAL_DB_PORT=3306
#CMI_SURVIVAL_DB_DATABASE=S1_CMI
#CMI_SURVIVAL_DB_SSL=true
#CMI_SURVIVAL_DB_SSL_CA=/etc/ssl/certs/mariadb-ca.pem
#CMI_SURVIVAL_DB_SSL_VERIFY=true
#CMI_SURVIVAL_DB_CONNECT_TIMEOUT=5
#CMI_SURVIVAL_DB_READ_TIMEOUT=30

# --- Balance source: Mining CMI ----------------------------------------------
# Required
CMI_MINING_DB_USER=CHANGE_ME
CMI_MINING_DB_PASSWORD=CHANGE_ME
#CMI_MINING_DB_DATABASE=S3_CMI

# --- Balance source: Skyblock CMI --------------------------------------------
# Required
CMI_SKYBLOCK_DB_USER=CHANGE_ME
CMI_SKYBLOCK_DB_PASSWORD=CHANGE_ME
#CMI_SKYBLOCK_DB_DATABASE=S5_CMI

# --- Rank source: LuckPerms (s4_perms) ---------------------------------------
# Required
LUCKPERMS_RO_DB_USER=CHANGE_ME
LUCKPERMS_RO_DB_PASSWORD=CHANGE_ME
# Optional overrides (defaults come from config.json / the script)
#LUCKPERMS_RO_DB_HOST=172.25.0.1
#LUCKPERMS_RO_DB_PORT=3306
#LUCKPERMS_RO_DB_DATABASE=s4_perms
#LUCKPERMS_RO_DB_SSL=true
#LUCKPERMS_RO_DB_SSL_CA=/etc/ssl/certs/mariadb-ca.pem
#LUCKPERMS_RO_DB_SSL_VERIFY=true
#LUCKPERMS_RO_DB_CONNECT_TIMEOUT=5
#LUCKPERMS_RO_DB_READ_TIMEOUT=30

# Override the output file (defaults to config.json -> output)
#ECONOMY_OUTPUT=/home/deploy/minecraft-website/data/economy.json
